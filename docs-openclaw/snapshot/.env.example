# Copy to .env and fill in to use a real LLM brain. Never commit .env.
# Default (no .env) runs MODEL_PROVIDER=mock -> unattended, no key needed.

# mock | sverk | anthropic | openai | ollama
MODEL_PROVIDER=mock

# Model id for the chosen provider, e.g.:
#   sverk     -> qwen-35        (default; custom ai.sverk.tech gateway)
#   anthropic -> claude-opus-4-8
#   openai    -> gpt-5.4
#   ollama    -> llama3.1:8b
MODEL=

# --- sverk custom gateway (OpenAI-compatible) ---
# Use:  MODEL_PROVIDER=sverk  +  make demo-sverk
SVERK_API_KEY=
SVERK_API_BASE=https://ai.sverk.tech/v1

# Keys (only the one matching MODEL_PROVIDER is needed). Kept out of images.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=
OLLAMA_BASE=http://host.docker.internal:11434

# Which fixture set the bridges serve.
SCENARIO=scenario-1

# Simulated rover step time (seconds) for navigate pose streaming.
NAV_STEP_SEC=0.15

# NOTE: with a real provider the agents need outbound access to the API.
# The `mesh` network is internal (no egress) by default for safety (§11) --
# attach the agent services to the `edge` network via a compose override to
# let them reach the provider endpoint.
